{
  "name": "mhp",
  "services": {
    "api": {
      "build": {"context": ".", "dockerfile": "deploy/Dockerfile.api"},
      "restart": "unless-stopped",
      "init": true,
      "env_file": [".env"],
      "environment": {
        "ALIPAY_ENABLED": "0",
        "MEMBERSHIP_REMINDERS_ENABLED": "0",
        "NUMBA_CACHE_DIR": "/app/data/.numba-cache",
        "XDG_CACHE_HOME": "/app/data/.cache"
      },
      "volumes": ["./data:/app/data"],
      "expose": ["8000"],
      "healthcheck": {
        "test": ["CMD", "python", "-c", "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=5))['status']=='ok'"],
        "interval": "30s", "timeout": "10s", "retries": 3, "start_period": "120s"
      },
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}}
    },
    "web": {
      "build": {"context": ".", "dockerfile": "deploy/Dockerfile.web"},
      "restart": "unless-stopped",
      "ports": ["127.0.0.1:8080:8080"],
      "depends_on": {"api": {"condition": "service_healthy"}},
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}}
    }
  }
}
