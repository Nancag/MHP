# Copy ONLY the required settings into .env. Never commit actual credentials.
AUTH_EMAIL_PROVIDER=netease_smtp
# Existing free NetEase mailbox: @163.com, @126.com or @yeah.net.
SMTP_USERNAME=
# Client authorization code, NOT your mailbox login password.
SMTP_AUTH_CODE=
# Any valid recipient email can register after successful code verification.
# Resend is retained as an explicit alternative, never an automatic fallback.
# AUTH_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=
# Local development uses HTTP. Enable this with HTTPS in production.
AUTH_COOKIE_SECURE=0
# Additional frontend origin(s), comma separated, only if deploying elsewhere.
AUTH_ALLOWED_ORIGINS=
# Optional persistent secret. When absent, data/.auth-secret is created locally.
AUTH_SECRET=
