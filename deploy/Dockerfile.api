FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements-cloud.txt requirements-cloud.lock ./
RUN python -m pip install --only-binary=:all: -r requirements-cloud.lock && python -m pip check
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY app ./app
COPY extensions/mhp-collector ./extensions/mhp-collector
COPY deploy/preflight.py ./deploy/preflight.py
COPY deploy/publish_downloads.py ./deploy/publish_downloads.py
COPY deploy/backup_worker.py ./deploy/backup_worker.py
RUN python -c "import ast,pathlib; [ast.parse(p.read_text(encoding='utf-8-sig'),filename=str(p)) for d in ('app','deploy') for p in pathlib.Path(d).rglob('*.py')]"
RUN useradd --uid 10001 --create-home mhp && mkdir -p /app/data && chown -R mhp:mhp /app/data
USER mhp
EXPOSE 8000
CMD ["python", "-B", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
