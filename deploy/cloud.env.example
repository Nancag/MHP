# Private cloud test only. Upload real secrets separately; never send them in chat.
AUTH_EMAIL_PROVIDER=netease_smtp
SMTP_USERNAME=
SMTP_AUTH_CODE=
# Local SSH forwarding only in this first deployment.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AUTH_COOKIE_SECURE=0
# Leave blank until a verified free API allowance or spend budget is authorized.
# Enable only after confirming free quota and provider stop-on-exhaustion for this exact model/region.
# Optional separate key. Singapore requires its own regional key.
ALIPAY_ENABLED=0
MEMBERSHIP_REMINDERS_ENABLED=0
