# Existing .env: add these only after obtaining and testing the merchant application.
# Do not paste private keys or SMTP authorization codes into chat.
ALIPAY_ENABLED=0
ALIPAY_ENV=production
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# RSA2 public-key mode, PEM files. Do not use certificate mode with this adapter.
ALIPAY_PRIVATE_KEY_PATH=D:/MHP/private/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=D:/MHP/private/alipay-public.pem
ALIPAY_NOTIFY_URL=https://YOUR_DOMAIN/api/account/alipay/notify
ALIPAY_RETURN_URL=https://YOUR_DOMAIN/
# Reuses the configured NetEase SMTP sender. Only paid members with due reminders are emailed.
MEMBERSHIP_REMINDERS_ENABLED=1
